# Set DATABASE_URL to the PostgreSQL connection string for your deployment.
DATABASE_URL=postgresql://user:password@host:5432/database
# JWT_SECRET is preferred; the app falls back to SESSION_SECRET when it is absent.
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
ADMIN_USERNAME=event-admin
ADMIN_PASSWORD=replace-before-running
NODE_ENV=development
